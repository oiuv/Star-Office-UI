# Star Office UI - production environment example
# Inject these values through your shell or service manager.
# Direct Python startup does not automatically load .env.

# Mark production mode to enable startup hardening checks
STAR_OFFICE_ENV=production

# Flask/session secret (REQUIRED in production)
# Must be long/random (>=24 chars)
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# Asset drawer password (REQUIRED in production)
# Do NOT use 1234 in production. Recommend >=8 chars.
ASSET_DRAWER_PASS=replace_with_strong_drawer_password

# OpenAI-compatible Image API (optional)
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_IMAGE_MODEL=gpt-image-2
# edit = reference editing; generate = text-to-image
AI_IMAGE_MODE=edit

# Remote hooks: same token on backend and Codex client.
# Without a token, only direct loopback requests are accepted.
STAR_OFFICE_HOOK_TOKEN=
# Client only: leave blank to record locally without a running server.
STAR_OFFICE_URL=
# Optional local paths / diagnostics
# STAR_OFFICE_EVENTS_DB=C:/AI/Star-Office-UI/data/office-events.sqlite3
# STAR_OFFICE_HOOK_DEBUG=1

# Recent notes: read this backend account's Codex memory (default ~/.codex).
# CODEX_HOME=C:/Users/your-user/.codex
