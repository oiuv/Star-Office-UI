{
  "description": "Star Office UI Codex lifecycle integration; replace paths, or generate with scripts/codex_hooks_config.py",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Star Office: 初始化"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Star Office: 收尾"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Star Office: 接收任务"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Star Office: 执行中"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Star Office: 请求权限"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "async": true,
            "statusMessage": "Star Office: 处理工具结果"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Star Office: 保存上下文"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Star Office: 恢复工作"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Star Office: Agent 工作中"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Star Office: Agent 收尾"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
            "timeout": 3,
            "statusMessage": "Star Office: 待命"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/Star-Office-UI/codex_hook.py\"",
            "commandWindows": "python \"C:\\AI\\Star-Office-UI\\codex_hook.py\"",
